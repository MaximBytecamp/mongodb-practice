# Скрипты выполняются внутри Linux-контейнеров: окончания строк только LF,
# даже если репозиторий склонирован на Windows.
*.sh     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf

# load.ps1 запускают в Windows PowerShell: CRLF и BOM оставляем как есть
*.ps1    -text
